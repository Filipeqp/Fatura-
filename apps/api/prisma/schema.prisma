generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String?
  googleId            String?              @unique
  createdAt           DateTime             @default(now())
  cards               Card[]
  categories          Category[]
  categoryRules       CategoryRule[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Card {
  id             String    @id @default(cuid())
  name           String
  brand          CardBrand @default(OTHER)
  lastFourDigits String?
  color          String    @default("#0d9488")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  OTHER
}

model Invoice {
  id             String        @id @default(cuid())
  cardId         String
  card           Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  referenceMonth DateTime
  dueDate        DateTime
  totalAmount    Float
  status         InvoiceStatus @default(OPEN)
  items          InvoiceItem[]
  createdAt      DateTime      @default(now())
  reminderSentAt DateTime?

  @@unique([cardId, referenceMonth])
  @@index([cardId])
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installment String?

  @@index([invoiceId])
  @@index([categoryId])
}

model Category {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  color         String
  monthlyBudget Float?
  items         InvoiceItem[]
  rules         CategoryRule[]

  @@unique([userId, name])
  @@index([userId])
}

model CategoryRule {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
  @@index([userId])
  @@index([categoryId])
}

enum InvoiceStatus {
  OPEN
  PAID
  OVERDUE
}
